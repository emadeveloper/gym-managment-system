# backend/.env.example
# JWT Configuration
JWT_SECRET=your_secret_key_here_minimum_64_characters
JWT_EXPIRATION=86400000

# Database (optional, for PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5434/la_resistencia_db
DATABASE_USERNAME=admin
DATABASE_PASSWORD=admin123

# SMTP (for emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
MERCADOPAGO_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_BACK_URL=http://localhost:5173/dashboard
MERCADOPAGO_DEFAULT_PLAN_CODE=monthly-standard
MERCADOPAGO_DEFAULT_PLAN_NAME=Membresia mensual
MERCADOPAGO_CURRENCY_ID=ARS
MERCADOPAGO_TRANSACTION_AMOUNT=25000
MERCADOPAGO_FREQUENCY=1
MERCADOPAGO_FREQUENCY_TYPE=months
